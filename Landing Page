<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>FieldFix AI — Industrial Troubleshooting Assistant</title>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600;700;800;900&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet"/>
<style>
:root{
  --orange:#e65c00;
  --orange-light:#ff7a1a;
  --dark:#0f0f0f;
  --dark2:#1a1a1a;
  --dark3:#242424;
  --gray:#888;
  --light:#f5f6f7;
  --white:#ffffff;
  --blue:#0078d4;
  --green:#107c10;
}
*{box-sizing:border-box;margin:0;padding:0;}
html{scroll-behavior:smooth;}
body{font-family:'DM Sans',sans-serif;background:var(--dark);color:var(--white);overflow-x:hidden;}

/* NAV */
nav{position:fixed;top:0;left:0;right:0;z-index:100;padding:16px 40px;display:flex;align-items:center;justify-content:space-between;background:rgba(15,15,15,0.9);backdrop-filter:blur(20px);border-bottom:1px solid rgba(255,255,255,0.06);}
.nav-logo{display:flex;align-items:center;gap:10px;}
.nav-logo-icon{width:36px;height:36px;background:var(--orange);border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:16px;}
.nav-logo-text{font-size:17px;font-weight:800;letter-spacing:-0.3px;}
.nav-links{display:flex;align-items:center;gap:32px;}
.nav-links a{font-size:14px;color:var(--gray);text-decoration:none;font-weight:500;transition:color 0.2s;}
.nav-links a:hover{color:var(--white);}
.nav-cta{display:flex;gap:12px;}
.btn-ghost{padding:8px 18px;border:1px solid rgba(255,255,255,0.15);border-radius:8px;font-size:14px;font-weight:600;color:var(--white);text-decoration:none;font-family:inherit;cursor:pointer;background:transparent;transition:all 0.2s;}
.btn-ghost:hover{border-color:var(--orange);color:var(--orange);}
.btn-primary{padding:8px 18px;background:var(--orange);border:none;border-radius:8px;font-size:14px;font-weight:700;color:var(--white);text-decoration:none;font-family:inherit;cursor:pointer;transition:all 0.2s;}
.btn-primary:hover{background:var(--orange-light);}

/* HERO */
#hero{min-height:100vh;display:flex;align-items:center;justify-content:center;padding:120px 40px 80px;position:relative;overflow:hidden;}
.hero-bg{position:absolute;inset:0;background:radial-gradient(ellipse 80% 60% at 50% 0%,rgba(230,92,0,0.12) 0%,transparent 70%);}
.hero-grid{position:absolute;inset:0;background-image:linear-gradient(rgba(255,255,255,0.03) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,0.03) 1px,transparent 1px);background-size:60px 60px;mask-image:radial-gradient(ellipse at center,black 30%,transparent 80%);}
.hero-content{max-width:800px;text-align:center;position:relative;z-index:1;}
.hero-badge{display:inline-flex;align-items:center;gap:8px;background:rgba(230,92,0,0.15);border:1px solid rgba(230,92,0,0.3);border-radius:20px;padding:6px 16px;font-size:12px;font-weight:600;color:var(--orange);letter-spacing:0.5px;margin-bottom:24px;text-transform:uppercase;}
.hero-badge-dot{width:6px;height:6px;background:var(--orange);border-radius:50%;animation:pulse-dot 2s ease-in-out infinite;}
h1{font-size:clamp(42px,7vw,80px);font-weight:900;line-height:1.05;letter-spacing:-2px;margin-bottom:24px;}
h1 span{color:var(--orange);}
.hero-sub{font-size:18px;color:var(--gray);line-height:1.6;max-width:560px;margin:0 auto 40px;font-weight:400;}
.hero-cta{display:flex;gap:16px;justify-content:center;flex-wrap:wrap;margin-bottom:60px;}
.btn-hero{padding:16px 32px;background:var(--orange);border:none;border-radius:12px;font-size:16px;font-weight:700;color:var(--white);text-decoration:none;font-family:inherit;cursor:pointer;transition:all 0.2s;letter-spacing:-0.2px;}
.btn-hero:hover{background:var(--orange-light);transform:translateY(-2px);box-shadow:0 12px 40px rgba(230,92,0,0.4);}
.btn-hero-ghost{padding:16px 32px;background:transparent;border:1.5px solid rgba(255,255,255,0.15);border-radius:12px;font-size:16px;font-weight:600;color:var(--white);text-decoration:none;font-family:inherit;cursor:pointer;transition:all 0.2s;}
.btn-hero-ghost:hover{border-color:var(--white);background:rgba(255,255,255,0.05);}
.hero-stats{display:flex;gap:48px;justify-content:center;flex-wrap:wrap;}
.stat{text-align:center;}
.stat-num{font-size:28px;font-weight:800;color:var(--white);letter-spacing:-1px;}
.stat-label{font-size:12px;color:var(--gray);font-weight:500;margin-top:2px;}

/* MARQUEE */
.marquee-wrap{padding:32px 0;border-top:1px solid rgba(255,255,255,0.06);border-bottom:1px solid rgba(255,255,255,0.06);overflow:hidden;background:rgba(255,255,255,0.02);}
.marquee{display:flex;gap:48px;animation:marquee 25s linear infinite;width:max-content;}
.marquee-item{display:flex;align-items:center;gap:10px;font-size:13px;font-weight:600;color:var(--gray);white-space:nowrap;font-family:'DM Mono',monospace;}
.marquee-item span{color:var(--orange);}
@keyframes marquee{0%{transform:translateX(0)}100%{transform:translateX(-50%)}}

/* DEMO */
#demo{padding:100px 40px;max-width:1100px;margin:0 auto;}
.section-label{font-size:12px;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:var(--orange);margin-bottom:12px;}
.section-title{font-size:clamp(28px,4vw,44px);font-weight:800;letter-spacing:-1px;margin-bottom:16px;line-height:1.1;}
.section-sub{font-size:16px;color:var(--gray);max-width:500px;line-height:1.6;}
.demo-grid{display:grid;grid-template-columns:1fr 1fr;gap:40px;margin-top:60px;align-items:start;}
.demo-left{}
.demo-chat{background:var(--dark2);border:1px solid rgba(255,255,255,0.08);border-radius:16px;overflow:hidden;}
.demo-chat-header{padding:14px 18px;border-bottom:1px solid rgba(255,255,255,0.06);display:flex;align-items:center;gap:10px;}
.demo-chat-icon{width:28px;height:28px;background:var(--orange);border-radius:6px;display:flex;align-items:center;justify-content:center;font-size:12px;}
.demo-chat-title{font-size:13px;font-weight:700;}
.demo-chat-status{margin-left:auto;display:flex;align-items:center;gap:5px;font-size:11px;color:#4caf50;}
.demo-chat-status-dot{width:6px;height:6px;background:#4caf50;border-radius:50%;}
.demo-messages{padding:18px;display:flex;flex-direction:column;gap:12px;min-height:320px;}
.dmsg{display:flex;gap:8px;align-items:flex-start;}
.dmsg.user{flex-direction:row-reverse;}
.dav{width:26px;height:26px;border-radius:6px;display:flex;align-items:center;justify-content:center;font-size:11px;flex-shrink:0;}
.dav.ai{background:var(--orange);}
.dav.user{background:var(--dark3);}
.dbub{max-width:85%;padding:10px 13px;font-size:12px;line-height:1.6;border-radius:3px 12px 12px 12px;}
.dbub.ai{background:var(--dark3);color:rgba(255,255,255,0.85);}
.dbub.user{background:rgba(230,92,0,0.2);border:1px solid rgba(230,92,0,0.3);color:var(--white);border-radius:12px 3px 12px 12px;}
.dbub strong{color:var(--orange-light);}
.demo-input{padding:12px 18px;border-top:1px solid rgba(255,255,255,0.06);display:flex;gap:8px;}
.demo-input-field{flex:1;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);border-radius:8px;padding:8px 12px;font-size:12px;color:var(--white);font-family:inherit;}
.demo-input-btn{background:var(--orange);border:none;border-radius:8px;padding:8px 14px;font-size:12px;font-weight:700;color:var(--white);cursor:pointer;font-family:inherit;}
.demo-right{display:flex;flex-direction:column;gap:20px;}
.feature-card{background:var(--dark2);border:1px solid rgba(255,255,255,0.07);border-radius:12px;padding:20px;transition:all 0.2s;}
.feature-card:hover{border-color:rgba(230,92,0,0.3);background:rgba(230,92,0,0.05);}
.fc-icon{font-size:22px;margin-bottom:10px;}
.fc-title{font-size:14px;font-weight:700;margin-bottom:6px;}
.fc-desc{font-size:12px;color:var(--gray);line-height:1.5;}

/* COVERAGE */
#coverage{padding:100px 40px;background:rgba(255,255,255,0.02);border-top:1px solid rgba(255,255,255,0.06);}
.coverage-inner{max-width:1100px;margin:0 auto;}
.coverage-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:16px;margin-top:48px;}
.cov-card{background:var(--dark2);border:1px solid rgba(255,255,255,0.07);border-radius:12px;padding:20px;transition:all 0.2s;}
.cov-card:hover{border-color:rgba(230,92,0,0.4);transform:translateY(-2px);}
.cov-icon{font-size:24px;margin-bottom:10px;}
.cov-brand{font-size:11px;font-weight:700;letter-spacing:1px;text-transform:uppercase;color:var(--orange);margin-bottom:4px;}
.cov-title{font-size:14px;font-weight:700;margin-bottom:6px;}
.cov-items{font-size:11px;color:var(--gray);line-height:1.8;font-family:'DM Mono',monospace;}

/* PRICING */
#pricing{padding:100px 40px;max-width:900px;margin:0 auto;text-align:center;}
.pricing-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-top:48px;max-width:600px;margin-left:auto;margin-right:auto;}
.price-card{background:var(--dark2);border:1px solid rgba(255,255,255,0.08);border-radius:16px;padding:32px 28px;text-align:left;position:relative;}
.price-card.featured{background:var(--orange);border-color:var(--orange);box-shadow:0 20px 60px rgba(230,92,0,0.35);}
.price-popular{position:absolute;top:-12px;left:50%;transform:translateX(-50%);background:var(--white);color:var(--orange);font-size:10px;font-weight:800;padding:3px 12px;border-radius:20px;letter-spacing:1px;white-space:nowrap;}
.price-name{font-size:14px;font-weight:700;color:rgba(255,255,255,0.6);margin-bottom:8px;}
.price-card.featured .price-name{color:rgba(255,255,255,0.8);}
.price-amount{font-size:40px;font-weight:900;letter-spacing:-2px;margin-bottom:4px;}
.price-period{font-size:13px;color:rgba(255,255,255,0.5);font-weight:400;}
.price-card.featured .price-period{color:rgba(255,255,255,0.7);}
.price-divider{height:1px;background:rgba(255,255,255,0.1);margin:20px 0;}
.price-card.featured .price-divider{background:rgba(255,255,255,0.25);}
.price-feature{display:flex;gap:8px;margin-bottom:8px;font-size:13px;color:rgba(255,255,255,0.7);}
.price-card.featured .price-feature{color:var(--white);}
.price-check{color:var(--orange);}
.price-card.featured .price-check{color:var(--white);}
.price-btn{margin-top:24px;width:100%;padding:13px;border-radius:10px;border:none;font-size:14px;font-weight:700;cursor:pointer;font-family:inherit;transition:all 0.2s;}
.price-btn-free{background:rgba(255,255,255,0.08);color:rgba(255,255,255,0.6);cursor:default;}
.price-btn-pro{background:var(--white);color:var(--orange);}
.price-btn-pro:hover{background:var(--light);}

/* VETERAN */
#veteran{padding:80px 40px;max-width:1100px;margin:0 auto;}
.vet-card{background:linear-gradient(135deg,rgba(230,92,0,0.1),rgba(0,120,212,0.1));border:1px solid rgba(230,92,0,0.2);border-radius:20px;padding:48px;display:flex;align-items:center;gap:48px;}
.vet-flag{font-size:48px;flex-shrink:0;}
.vet-content{}
.vet-badge{display:inline-flex;align-items:center;gap:8px;background:rgba(230,92,0,0.15);border:1px solid rgba(230,92,0,0.3);border-radius:20px;padding:5px 14px;font-size:11px;font-weight:700;color:var(--orange);letter-spacing:1px;text-transform:uppercase;margin-bottom:14px;}
.vet-title{font-size:24px;font-weight:800;letter-spacing:-0.5px;margin-bottom:10px;}
.vet-desc{font-size:14px;color:var(--gray);line-height:1.6;}

/* CTA */
#cta{padding:100px 40px;text-align:center;position:relative;overflow:hidden;}
.cta-bg{position:absolute;inset:0;background:radial-gradient(ellipse 60% 80% at 50% 100%,rgba(230,92,0,0.12),transparent 70%);}
.cta-content{position:relative;z-index:1;max-width:600px;margin:0 auto;}
.cta-title{font-size:clamp(32px,5vw,56px);font-weight:900;letter-spacing:-2px;margin-bottom:16px;line-height:1.05;}
.cta-sub{font-size:16px;color:var(--gray);margin-bottom:36px;line-height:1.6;}

/* FOOTER */
footer{padding:40px;border-top:1px solid rgba(255,255,255,0.06);display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:16px;}
.footer-logo{display:flex;align-items:center;gap:8px;}
.footer-logo-icon{width:28px;height:28px;background:var(--orange);border-radius:6px;display:flex;align-items:center;justify-content:center;font-size:12px;}
.footer-logo-text{font-size:14px;font-weight:700;}
.footer-links{display:flex;gap:24px;}
.footer-links a{font-size:13px;color:var(--gray);text-decoration:none;}
.footer-links a:hover{color:var(--white);}
.footer-copy{font-size:12px;color:rgba(255,255,255,0.3);}

@keyframes pulse-dot{0%,100%{opacity:1}50%{opacity:0.4}}

@media(max-width:768px){
  nav{padding:14px 20px;}
  .nav-links{display:none;}
  #hero{padding:100px 20px 60px;}
  .demo-grid{grid-template-columns:1fr;}
  .pricing-grid{grid-template-columns:1fr;}
  .vet-card{flex-direction:column;gap:24px;padding:32px 24px;}
  #demo,#coverage,#pricing,#veteran,#cta{padding:60px 20px;}
  footer{padding:24px 20px;}
  .hero-stats{gap:32px;}
}
</style>
</head>
